CREATE TABLE emails (
  id TEXT NOT NULL PRIMARY KEY,
  sender_pubkey TEXT NOT NULL,
  -- Lowercased in Dart: SQLite folds the case of ASCII only.
  sender_key TEXT NOT NULL,
  recipient_pubkey TEXT NOT NULL,
  is_public BOOLEAN NOT NULL,
  is_bridged BOOLEAN NOT NULL,
  light_mime_text TEXT NOT NULL,
  blossom_hash TEXT,
  decryption_key TEXT,
  decryption_nonce TEXT,
  created_at INTEGER NOT NULL,
  date INTEGER NOT NULL,
  from_address TEXT NOT NULL,
  from_name TEXT,
  subject TEXT NOT NULL,
  body_plain TEXT NOT NULL,
  preview TEXT NOT NULL DEFAULT '',
  -- JSON arrays of {name, email}, so a listing draws the header line without
  -- reading light_mime_text.
  to_addresses TEXT NOT NULL DEFAULT '[]',
  cc_addresses TEXT NOT NULL DEFAULT '[]',
  bcc_addresses TEXT NOT NULL DEFAULT '[]'
) AS EmailRow;
CREATE INDEX emails_recipient_date ON emails (recipient_pubkey, date);
CREATE INDEX emails_recipient_sender_key ON emails (recipient_pubkey, sender_key);

CREATE TABLE attachments (
  email_id TEXT NOT NULL REFERENCES emails (id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  filename TEXT,
  content_type TEXT NOT NULL,
  size INTEGER NOT NULL,
  sha256 TEXT NOT NULL,
  content_id TEXT,
  PRIMARY KEY (email_id, position)
) AS AttachmentRow;

-- One row per label event, not per label: two devices can apply the same label
-- before either sees the other, and removing it has to name both.
-- No foreign key to emails: a label can land before the email it points at.
CREATE TABLE labels (
  label_event_id TEXT NOT NULL PRIMARY KEY,
  email_id TEXT NOT NULL,
  label TEXT NOT NULL,
  -- The gift wrap that carried the label, which is what a deletion names.
  -- Null for a label published in clear.
  wrap_id TEXT,
  timestamp INTEGER NOT NULL,
  recipient_pubkey TEXT NOT NULL,
  -- The user folder a folder:trash or folder:archive label moved the email out
  -- of, applied again on restore.
  prev_folder TEXT
) AS LabelRow;
CREATE INDEX labels_recipient_label ON labels (recipient_pubkey, label);
-- email_states resolves the folder, read and starred state per row through
-- correlated subqueries keyed on email_id. Without this, each one rescans
-- every label of the account and any query filtering on folder walks the
-- whole mailbox.
CREATE INDEX labels_email_recipient ON labels (email_id, recipient_pubkey, label);
CREATE INDEX labels_wrap_id ON labels (wrap_id);

-- The user folders and tags whose match condition holds each email, from the
-- private settings. Computed in Dart: SQLite folds the case of ASCII only.
CREATE TABLE matches (
  email_id TEXT NOT NULL REFERENCES emails (id) ON DELETE CASCADE,
  recipient_pubkey TEXT NOT NULL,
  entry_id TEXT NOT NULL,
  is_folder BOOLEAN NOT NULL,
  -- The folder's place in display order: the first match wins.
  rank INTEGER NOT NULL,
  PRIMARY KEY (email_id, entry_id)
) AS MatchRow;
CREATE INDEX matches_recipient_entry ON matches (recipient_pubkey, entry_id);

CREATE TABLE gift_wraps (
  id TEXT NOT NULL PRIMARY KEY,
  recipient_pubkey TEXT NOT NULL,
  event TEXT NOT NULL,
  stage TEXT NOT NULL,
  attempts INTEGER NOT NULL DEFAULT 0,
  failure TEXT
) AS GiftWrapRow;
CREATE INDEX gift_wraps_recipient_stage ON gift_wraps (recipient_pubkey, stage);

-- What a wrap yielded once opened. Raw: only the signer can produce it again,
-- so it carries its own recipient rather than joining gift_wraps, which a
-- schema change drops from under it.
CREATE TABLE unsealed (
  wrap_id TEXT NOT NULL PRIMARY KEY,
  recipient_pubkey TEXT NOT NULL,
  -- Null for a label, which travels signed without a seal: rumor then holds
  -- the signed label itself.
  seal TEXT,
  rumor TEXT NOT NULL,
  rumor_id TEXT NOT NULL
) AS UnsealedRow;
CREATE INDEX unsealed_rumor_id ON unsealed (rumor_id);

CREATE TABLE tombstones (
  event_id TEXT NOT NULL PRIMARY KEY,
  recipient_pubkey TEXT NOT NULL,
  created_at INTEGER NOT NULL
) AS TombstoneRow;

-- Raw as well: the NIP-78 payload is NIP-44 encrypted to the account itself.
CREATE TABLE settings (
  pubkey TEXT NOT NULL PRIMARY KEY,
  json TEXT NOT NULL
) AS SettingsRow;

-- What the signer made of a senders list event. Raw: only the signer can
-- produce it again.
CREATE TABLE sender_list_decryptions (
  event_id TEXT NOT NULL PRIMARY KEY,
  recipient_pubkey TEXT NOT NULL,
  -- Null until decrypted.
  plaintext TEXT,
  failure TEXT,
  attempts INTEGER NOT NULL DEFAULT 0
) AS SenderListDecryptionRow;

-- One row per entry of a senders list event, an Add or a Remove.
CREATE TABLE sender_ops (
  event_id TEXT NOT NULL,
  recipient_pubkey TEXT NOT NULL,
  sender_key TEXT NOT NULL,
  is_add BOOLEAN NOT NULL,
  verdict TEXT,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (event_id, sender_key)
) AS SenderOpRow;
CREATE INDEX sender_ops_sender ON sender_ops (recipient_pubkey, sender_key, created_at);

-- The verdict of the most recent Add, unless a Remove is strictly later. Two
-- Adds in the same second: the lowest event id wins. A winning Add holding
-- neither allow nor block leaves the sender with no verdict.
CREATE VIEW sender_verdicts AS SenderVerdictRow AS
SELECT a.recipient_pubkey, a.sender_key, a.verdict
FROM sender_ops a
WHERE a.is_add AND a.verdict IN ('allow', 'block')
  AND NOT EXISTS (SELECT 1 FROM sender_ops b
    WHERE b.recipient_pubkey = a.recipient_pubkey AND b.sender_key = a.sender_key
      AND (b.created_at > a.created_at
        OR (b.is_add AND b.created_at = a.created_at AND b.event_id < a.event_id)));

-- The folder is the most recent folder label. Received mail then goes by the
-- verdict of its sender: spam when blocked, requests when it has none. What is
-- left goes to the first user folder whose condition holds, else the natural
-- mailbox.
CREATE VIEW email_states AS
SELECT e.*,
  COALESCE(
    (SELECT substr(l.label, 8) FROM labels l
      WHERE l.email_id = e.id AND l.recipient_pubkey = e.recipient_pubkey
        AND l.label LIKE 'folder:%'
      ORDER BY l.timestamp DESC LIMIT 1),
    CASE WHEN e.sender_pubkey <> e.recipient_pubkey THEN
      CASE (SELECT s.verdict FROM sender_verdicts s
            WHERE s.recipient_pubkey = e.recipient_pubkey
              AND s.sender_key = e.sender_key)
        WHEN 'allow' THEN NULL
        WHEN 'block' THEN 'spam'
        ELSE 'requests'
      END
    END,
    (SELECT m.entry_id FROM matches m
      WHERE m.email_id = e.id AND m.is_folder
      ORDER BY m.rank LIMIT 1),
    CASE WHEN e.sender_pubkey = e.recipient_pubkey THEN 'sent' ELSE 'inbox' END
  ) AS folder,
  EXISTS(SELECT 1 FROM labels l WHERE l.email_id = e.id
    AND l.recipient_pubkey = e.recipient_pubkey AND l.label = 'state:read') AS is_read,
  EXISTS(SELECT 1 FROM labels l WHERE l.email_id = e.id
    AND l.recipient_pubkey = e.recipient_pubkey AND l.label = 'flag:starred') AS is_starred
FROM emails e;

-- External-content index: the text stays in emails, only tokens are stored.
CREATE VIRTUAL TABLE email_search USING fts5(
  from_address, subject, body_plain,
  content='emails', content_rowid='rowid', tokenize='unicode61'
);
CREATE TRIGGER emails_ai AFTER INSERT ON emails BEGIN
  INSERT INTO email_search(rowid, from_address, subject, body_plain)
    VALUES (new.rowid, new.from_address, new.subject, new.body_plain);
END;
CREATE TRIGGER emails_ad AFTER DELETE ON emails BEGIN
  INSERT INTO email_search(email_search, rowid, from_address, subject, body_plain)
    VALUES ('delete', old.rowid, old.from_address, old.subject, old.body_plain);
END;
CREATE TRIGGER emails_au AFTER UPDATE ON emails BEGIN
  INSERT INTO email_search(email_search, rowid, from_address, subject, body_plain)
    VALUES ('delete', old.rowid, old.from_address, old.subject, old.body_plain);
  INSERT INTO email_search(rowid, from_address, subject, body_plain)
    VALUES (new.rowid, new.from_address, new.subject, new.body_plain);
END;
